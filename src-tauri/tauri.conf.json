{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LabReport Studio",
  "version": "0.1.0",
  "identifier": "io.github.kintoned.labreport-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "実験レポート統括ソフト",
        "width": 1500,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Japanese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBODZCMDU4Q0Q1QzlDMkIKUldRcm5Gek5XTENHeW1DT3JROGVNZ2x0STlNRmh0TGI1c2VJbkVyaVUrK0JNZFFTaU1LUmU0cnAK",
      "endpoints": [
        "https://github.com/kintoned/labreport-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
